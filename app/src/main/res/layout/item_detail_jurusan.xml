<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#4A0620"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="0.5dp"
    app:strokeColor="#33FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="14dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvJurusanKelas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_body"
            tools:text="RPL - Kelas 10" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvJumlahBelumLunas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D9A441"
                android:textStyle="bold"
                android:textSize="16sp"
                android:fontFamily="@font/font_body"
                tools:text="1 orang" />

            <TextView
                android:id="@+id/tvTotalInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/font_body"
                tools:text="belum lunas dari 1 total" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
